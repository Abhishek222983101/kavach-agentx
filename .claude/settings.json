{
  "env": {
    "DO_NOT_TRACK": "1"
  },
  "permissions": {
    "allow": [
      "Read(docs/**)",
      "Edit(docs/**)",
      "Write(docs/**)",
      "Edit(AGENTS.md)",
      "Edit(CLAUDE.md)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.mjs"],
            "timeout": 15,
            "statusMessage": "Loading project notebook"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/log-prompt.mjs"],
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/stop-check.mjs"],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
