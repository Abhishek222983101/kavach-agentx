   "from": 1888,
   "frames": 121,
   "lines": [
    {
     "id": "s17",
     "from": 8,
     "frames": 91,
     "text": "An instruction hidden inside an order note. Ignored."
    }
   ]
  },
  {
   "name": "call",
   "from": 2009,
   "frames": 176,
   "lines": [
    {
     "id": "s18",
     "from": 8,
     "frames": 86,
     "text": "And when a refund is big, Kavach phones the seller."
    }
   ]
  },
  {
   "name": "pressone",
   "from": 2185,
   "frames": 130,
   "lines": [
    {
     "id": "s20",
     "from": 8,
     "frames": 100,
     "text": "One key. The checker verifies again, then pays."
    }
   ]
  },
  {
   "name": "run",
   "from": 2315,
   "frames": 242,
   "lines": [
    {
     "id": "s21",
     "from": 8,
     "frames": 65,
     "text": "You don't have to trust us. Press Run."
    },
    {
     "id": "s22",
     "from": 86,
     "frames": 134,
     "text": "The AI's database account can't write a refund. Postgres says no."
    }
   ]
  },
  {
   "name": "tamper",
   "from": 2557,
   "frames": 107,
   "lines": [
    {
     "id": "s23",
     "from": 8,
     "frames": 77,
     "text": "Change one line of the log, and the chain finds it."
    }
   ]
  },
  {
   "name": "eval",
   "from": 2664,
   "frames": 318,
   "lines": [
    {
     "id": "s24",
     "from": 8,
     "frames": 160,
     "text": "We ran nineteen attacks against it. Kavach paid nothing, and turned no honest customer away."
    },
    {
     "id": "s25",
     "from": 181,
     "frames": 115,
     "text": "An AI with strict rules in its prompt still paid out six times."
    }
   ]
  },
  {
   "name": "guard",
   "from": 2982,
   "frames": 97,
   "lines": [
    {
     "id": "s26",
     "from": 8,
     "frames": 67,
     "text": "And we trained our own guard for Indian chats."
    }
   ]
  },
  {
