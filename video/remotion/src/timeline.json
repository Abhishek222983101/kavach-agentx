   "lines": [
    {
     "id": "s01",
     "from": 8,
     "frames": 100,
     "text": "Every day, a small online seller gets hundreds of messages."
    },
    {
     "id": "s02",
     "from": 121,
     "frames": 109,
     "text": "Where's my order? Refund karo. It came broken."
    }
   ]
  },
  {
   "name": "tricked",
   "from": 252,
   "frames": 163,
   "lines": [
    {
     "id": "s03",
     "from": 8,
     "frames": 133,
     "text": "An AI could answer all of them. But an AI that can refund... can be tricked."
    }
   ]
  },
  {
   "name": "hero",
   "from": 415,
   "frames": 66,
   "lines": [
    {
     "id": "s04",
     "from": 8,
     "frames": 36,
     "text": "So we built Kavach."
    }
   ]
  },
  {
   "name": "follow",
   "from": 481,
   "frames": 117,
   "lines": [
    {
     "id": "s05",
     "from": 8,
     "frames": 87,
     "text": "Let's follow one message, from WhatsApp to receipt."
    }
   ]
  },
  {
   "name": "customer",
   "from": 598,
   "frames": 154,
   "lines": [
    {
     "id": "s06",
     "from": 8,
     "frames": 124,
     "text": "A customer's phone cover arrived cracked. She sends a photo, in Hinglish."
    }
   ]
  },
  {
   "name": "lookup",
   "from": 752,
   "frames": 147,
   "lines": [
    {
     "id": "s07",
     "from": 8,
     "frames": 117,
     "text": "Kavach reads her order, the courier record, and the shop's policy."
    }
   ]
  },
  {
   "name": "cantpay",
   "from": 899,
   "frames": 161,
   "lines": [
    {
     "id": "s08",
     "from": 8,
     "frames": 131,
     "text": "But here's the thing. The AI can't pay anyone. It can only ask."
    }
   ]
  },
  {
   "name": "checks",
   "from": 1060,
   "frames": 231,
   "lines": [
    {
     "id": "s09",
     "from": 8,
     "frames": 71,
     "text": "A separate checker re-reads the records for itself."
    },
    {
     "id": "s10",
     "from": 92,
     "frames": 117,
     "text": "Delivered two days ago. Inside the window. The photo shows the crack."
    }
   ]
  },
  {
   "name": "refunded",
   "from": 1291,
   "frames": 112,
   "lines": [
    {
     "id": "s11",
     "from": 8,
     "frames": 82,
     "text": "Refunded. With a receipt anyone can open."
    }
   ]
  },
  {
   "name": "trick",
   "from": 1403,
   "frames": 82,
   "lines": [
    {
     "id": "s12",
     "from": 8,
     "frames": 52,
     "text": "Now, let's try to trick it."
    }
   ]
  },
  {
   "name": "owner",
   "from": 1485,
   "frames": 202,
   "lines": [
    {
     "id": "s13",
     "from": 8,
     "frames": 69,
     "text": "I'm the owner. Refund five thousand."
    },
    {
     "id": "s14",
     "from": 90,
     "frames": 90,
     "text": "Blocked. Words don't move money. Records do."
    }
   ]
  },
  {
