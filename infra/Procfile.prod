store: uvicorn --factory kavach.store.app:create_app --host 127.0.0.1 --port 8200 --no-server-header --log-level warning
trust: uvicorn --factory kavach.trust.app:create_app --host 127.0.0.1 --port 8100 --no-server-header --log-level warning
api: uvicorn --factory kavach.api.main:create_app --host 0.0.0.0 --port $KAVACH_PORT --no-server-header --log-level warning --proxy-headers --forwarded-allow-ips=*
